# Server Configuration
PORT=8000
HOST=0.0.0.0
DEBUG=True
APP_NAME="Surplus-to-Shelter API"
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Database Configuration (PostgreSQL / SQLite fallback for seamless dev)
